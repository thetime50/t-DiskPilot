{
  "name": "t-diskpilot",
  "version": "1.2.0",
  "description": "t-DiskPilot — disk space tool (scan / clean / optimize / suggest) — React + Vite + Tauri",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:ui": "vite",
    "dev": "concurrently -k -n server,ui -c blue,green \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "sass": "^1.83.0",
    "concurrently": "^9.1.0",
    "@tauri-apps/cli": "^2.1.0",
    "@tauri-apps/api": "^2.1.1"
  }
}
