{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t-DiskPilot",
  "version": "1.2.0",
  "identifier": "com.tdiskpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "t-DiskPilot",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#0b1419",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
